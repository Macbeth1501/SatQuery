# SatQuery AI backend configuration. Copy to .env and export, or set in your shell.
# Every variable is optional; the values shown are the defaults.

# Where uploads, overlays, PDFs and session records are written.
# SATQUERY_STORAGE_DIR=backend/storage

# SQLite file holding session records (default: <storage dir>/satquery.db).
# SATQUERY_DATABASE_PATH=backend/storage/satquery.db

# Server bind address. Loopback by default; use 0.0.0.0 deliberately, not by accident.
# SATQUERY_HOST=127.0.0.1
# SATQUERY_PORT=8000

# Comma-separated browser origins allowed to call the API.
# SATQUERY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Compatibility-validator thresholds (percent, 0-100).
# SATQUERY_MIN_FOOTPRINT_OVERLAP_PERCENT=70
# SATQUERY_MAX_NODATA_PERCENT=40
# SATQUERY_CLOUD_MASK_WARN_PERCENT=40

# Confidence scoring.
# SATQUERY_OPTICAL_CLOUD_DEGRADED_PERCENT=40
# SATQUERY_HIGH_INTENT_CONFIDENCE=0.85

# Real model for single-image questions. Unset keeps the demo engine. Start the server
# with `.venv-ml/Scripts/python.exe ml/serve_vqa.py --port 8001`, then set:
# SATQUERY_VQA_MODEL_URL=http://127.0.0.1:8001
# SATQUERY_VQA_MODEL_TIMEOUT_SECONDS=60
# Resident adapter to answer with (GET <model url>/adapters lists them); run2 is the live demo's.
# SATQUERY_VQA_MODEL_ADAPTER=run2
# Model answer probability needed for a Medium tier (a model answer is never High).
# SATQUERY_MODEL_MEDIUM_PROBABILITY=0.75

# Docker Compose: this file is loaded into the backend container if present. Leave
# SATQUERY_HOST, SATQUERY_PORT and SATQUERY_STORAGE_DIR unset there; Compose fixes them.
